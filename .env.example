# ===========================================
# DARUSSOLAH PROJECT - ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!
# ===========================================

# -------------------------------------------
# Application Settings
# -------------------------------------------
DARUSSOLAH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
DARUSSOLAH_ENVIRONMENT=development
DARUSSOLAH_JWT_SECRET=generate-a-secure-random-secret-here-min-32-chars
DARUSSOLAH_REGISTRATION_MAX_BYTES=5242880
DARUSSOLAH_TENANT_SLUG=darussolah

# -------------------------------------------
# Database Configuration (PostgreSQL)
# -------------------------------------------
SQL_HOST=localhost
SQL_PORT=5432
SQL_DB_NAME=darussolah
SQL_USER=darussolah_user
SQL_PASSWORD=change-this-to-a-strong-password
SQL_ADMIN_USER=darussolah_admin
SQL_ADMIN_PASSWORD=change-this-to-another-strong-password

# For Drizzle ORM (uses admin credentials for migrations)
DATABASE_URL=postgresql://darussolah_admin:change-this-to-another-strong-password@localhost:5432/darussolah

# -------------------------------------------
# Firebase Configuration
# Get these from Firebase Console > Project Settings
# -------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_APP_ID=1:your-app-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
FIREBASE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
FIREBASE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# -------------------------------------------
# Default User Passwords (for seed script only)
# CHANGE THESE IN PRODUCTION!
# -------------------------------------------
DEFAULT_ADMIN_PASSWORD=ChangeMe123!StrongPassword
DEFAULT_GURU_PASSWORD=ChangeMe456!AnotherStrongPassword

# -------------------------------------------
# Supabase (if used)
# -------------------------------------------
DARUSSOLAH_SUPABASE_URL=https://your-project.supabase.co
DARUSSOLAH_SUPABASE_ANON_KEY=your-supabase-anon-key
